# ---------------------------------------------------------------------------
# Ember backend environment.
# Copy to `.env` for local development. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL only. SQLite is not supported.
# Local:      postgresql+psycopg://USER@localhost:5432/ember_dev
# Neon:       postgresql+psycopg://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/ember?sslmode=require
DATABASE_URL=postgresql+psycopg://localhost:5432/ember_dev

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Ember serves its UI and API from a single origin, so these are the same host.
FRONTEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# --- GitHub OAuth ----------------------------------------------------------
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email
# Provider access tokens are not needed for sign-in; keep this false.
STORE_GITHUB_TOKENS=false

# --- Sessions --------------------------------------------------------------
SESSION_COOKIE_NAME=ember_session
SESSION_MAX_AGE_DAYS=30

# --- Client behaviour ------------------------------------------------------
POLLING_INTERVAL_MS=4000

# --- Admin bootstrap (server-side only; never sent to the browser) ---------
# Comma-separated. A user matching one of these is granted the admin role the
# first time their account is created. Existing roles are never changed here.
ADMIN_GITHUB_USERNAMES=
ADMIN_EMAILS=

# --- Rate limiting ---------------------------------------------------------
# Per-account budget (brute force against one person).
LOGIN_MAX_ATTEMPTS=8
# Per-source-address budget. Deliberately much larger: behind a reverse proxy
# the whole cohort can share one address, so a small value would let a few
# failures lock everyone out.
LOGIN_MAX_ATTEMPTS_PER_IP=40
SIGNUP_MAX_ATTEMPTS_PER_IP=10
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# --- Proxy -----------------------------------------------------------------
# X-Forwarded-For is attacker-controlled unless a trusted proxy sets it, and it
# feeds the rate limiter. Set true on Render / Fly / Railway; leave false when
# the app is directly exposed.
TRUST_PROXY_HEADERS=false

ENVIRONMENT=development

# --- Email delivery --------------------------------------------------------
# Powers password reset and email verification. When SMTP is left unset, mail is
# written to the application log ("console" backend) so local development is
# honest -- nothing is silently dropped or faked.
#   EMAIL_BACKEND: auto (default) | smtp | console
EMAIL_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Ember
SMTP_USE_TLS=true

# --- Email verification and password reset ---------------------------------
# When true, a new email/password account must confirm its address before using
# Ember, and signup stops disclosing whether an address is already registered.
# Requires SMTP to be configured (the app refuses to boot in production
# otherwise).
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_MAX_REQUESTS_PER_IP=10
VERIFICATION_MAX_REQUESTS_PER_IP=10
